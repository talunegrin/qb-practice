{
  "version": 2,
  "name": "football-tracker",
  "builds": [
    {
      "src": "football-tracker-enhanced.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/firebase-config",
      "dest": "/api/firebase-config.js"
    },
    {
      "src": "/(.*)",
      "dest": "/football-tracker-enhanced.html"
    }
  ]
}